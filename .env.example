DISCORD_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-discord-application-id

# Optional: used only to remove legacy guild-specific commands during migration.
DISCORD_GUILD_ID=

# Optional: required only for Steam vanity-name and /id/ profile resolution.
STEAM_WEB_API_KEY=

# Optional: shows Steam's historical low price in sale alerts (free key from
# https://isthereanydeal.com/apps/my/). Only game IDs and the Store country are sent.
ITAD_API_KEY=

# Optional: the top.gg API token (top.gg > your bot > Integrations & API).
# When set, the server count on the top.gg page is updated hourly.
TOPGG_TOKEN=

# Optional in local development; set it in production for the branded setup screen.
# Host docs/assets/dealio-onboarding-banner.png on a stable public HTTPS URL.
DEALIO_BANNER_URL=

DATABASE_PATH=./data/wishlist.db
# Wait 30 minutes after a completed scan; 0.5 hours = 30 minutes.
POLL_INTERVAL_HOURS=0.5
NOTIFICATION_RETRY_INTERVAL_SECONDS=60
# Optional sign-up cap. Empty means no cap; existing users are never affected.
# The owner can also set or lift a cap from the admin panel without a restart.
DEALIO_MAX_USERS=

# Optional owner admin panel (docs/admin-panel.tr.md). Listens on 127.0.0.1 only and is
# reached through an SSH tunnel. Generate a long random token, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave empty to keep the panel off.
DEALIO_ADMIN_TOKEN=
DEALIO_ADMIN_PORT=8787

# Optional support tickets in the Dealio support server (docs/support-server.tr.md).
# `npm run support:setup` prints all three; set all of them or none.
DEALIO_SUPPORT_GUILD_ID=
DEALIO_SUPPORT_LOG_CHANNEL_ID=
DEALIO_SUPPORT_TEAM_ROLE_ID=

# Azure production must set true. Provision the private <app-id>.lock blob first.
DEALIO_PRODUCTION=false
AZURE_LEASE_CONTAINER_URL=
# Mandatory on developer machines: protects against accidental production login.
PRODUCTION_DISCORD_CLIENT_ID=
AZURE_BACKUP_CONTAINER_URL=
AZURE_MONITOR_ENDPOINT=
AZURE_MONITOR_RULE_ID=
AZURE_MONITOR_STREAM=Custom-DealioHealth


# Controlled rollout on one existing Linux VM only, while Azure lease resources
# await provisioning. Set DEALIO_PRODUCTION=true and pin /etc/machine-id.
# Keep empty for the normal Azure lease deployment. No cross-host lease guarantee.
DEALIO_SINGLE_HOST_MACHINE_ID=
