{
  "name": "dealio",
  "version": "1.0.0",
  "private": true,
  "description": "Dealio notifies Discord users when Steam wishlist games go on sale.",
  "license": "MIT",
  "homepage": "https://github.com/byzephyron/dealio-steam-deals-bot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byzephyron/dealio-steam-deals-bot.git"
  },
  "bugs": {
    "url": "https://github.com/byzephyron/dealio-steam-deals-bot/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.admin-ui.json && node scripts/copy-admin-assets.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.admin-ui.json --noEmit",
    "typecheck:scenarios": "tsc -p tsconfig.scenarios.json",
    "test:capacity": "tsx scripts/capacity-check.ts",
    "pretest": "npm run build",
    "test": "vitest run --passWithNoTests --maxWorkers=4",
    "preview:ui": "npm run build && node scripts/preview-ui.mjs",
    "backup": "node scripts/backup.mjs",
    "restore:test": "node scripts/backup.mjs --restore-test",
    "monitor:preview": "node scripts/monitor.mjs --preview",
    "metrics:report": "node scripts/metrics-report.mjs",
    "release:check": "node scripts/release-gate.mjs",
    "preview:admin": "npm run build && node scripts/preview-admin.mjs",
    "support:setup": "tsx scripts/setup-support-server.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.2",
    "@azure/monitor-ingestion": "^1.2.0",
    "@azure/storage-blob": "^12.33.0",
    "discord.js": "^14.27.0",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^24.0.0",
    "htm": "^3.1.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
